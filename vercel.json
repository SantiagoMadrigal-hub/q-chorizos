{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "rewrites": [
    { "source": "/terminos", "destination": "/terminos.html" },
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/formulario", "destination": "/html-css/formulario/formulario.html" },
    { "source": "/nosotros", "destination": "/html-css/contenido basico de la pagina/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fotos-proyectos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}